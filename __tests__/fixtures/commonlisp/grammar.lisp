(defpackage #:example (:export #:normalize-settings))
(in-package :example)
(defun normalize-settings (settings)
  (remove-if #'null settings))
(defgeneric serialize (value))
(defmethod serialize ((value record))
  (encode-record value))
(defmacro with-record ((name record) &body body)
  `(let ((,name ,record)) ,@body))
(defclass record () ((value :initarg :value)))
(defstruct settings timeout)
(defparameter *default-settings* (make-settings))
(defun quoted-data () '(not-a-call (still-data)))
(defun string-data () "(also-not-a-call)")
